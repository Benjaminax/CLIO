# ============================================================
# CLIO Backend Environment Variables (Phase 1)
# ============================================================

# --- APP CONFIGURATION ---
APP_NAME="CLIO API"
DEBUG=true
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173

# --- DATABASE (MONGODB ATLAS) ---
# Replace with your MongoDB Atlas connection URI or local MongoDB
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=DATA

# --- REDIS (CELERY JOB QUEUE) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT AUTHENTICATION ---
# Generate using: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_secure_64_character_hex_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- FILE STORAGE ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

# S3 Configuration (Optional for production)
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=clio-storage
# S3_REGION=auto

# --- EMAIL (OPTIONAL) ---
# RESEND_API_KEY=re_xxxxxxxxxxxx
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@clio.app

# --- AI & OLLAMA (PHASE 5) ---
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# --- LIMITS ---
MAX_UPLOAD_SIZE_MB=500

